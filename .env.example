# Application
NODE_ENV=development

# NestJS API
API_PORT=3001
WEB_URL=http://localhost:3000

# Next.js frontend (public, baked into the browser bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL (local docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flower_crm
POSTGRES_PORT=5432

# Prisma / NestJS database connection
# Local: host port from docker-compose.yml
# Production Compose: use host postgres service name inside containers
#   postgresql://USER:PASSWORD@postgres:5432/DB?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flower_crm?schema=public

# Auth
# Generate production secret: openssl rand -base64 48
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-32chars
JWT_ACCESS_TTL_SECONDS=900
SESSION_TTL_SECONDS=1209600
AUTH_COOKIE_NAME=erp_refresh
AUTH_LOGIN_MAX_ATTEMPTS=20
AUTH_LOGIN_WINDOW_SECONDS=60

# Express trust proxy hop count. false/0 = disabled (default for local).
# Behind host Nginx (one hop): set TRUST_PROXY=1
# TRUST_PROXY=false

# Business calendar / order numbers / "today" (IANA time zone)
BUSINESS_TIME_ZONE=Europe/Minsk

# Address suggestions (orders delivery). Prefer Yandex Geosuggest for BY/RU.
# Get a key: https://developer.tech.yandex.ru/services/ → Geosuggest (+ Geocoder for coords)
# YANDEX_MAPS_API_KEY=
# Optional bias to shop city (lon,lat). Grodno example:
# YANDEX_SUGGEST_LL=23.8313,53.6694

# Seed (development / explicit bootstrap only). Refuses NODE_ENV=production.
# SEED_RESET_PASSWORDS=true

# -----------------------------------------------------------------------------
# Production example (VPS /opt/apps/newerp/.env) — DO NOT commit real secrets
# -----------------------------------------------------------------------------
# NODE_ENV=production
# WEB_URL=https://erp.nasytko.ru
# NEXT_PUBLIC_API_URL=https://erp.nasytko.ru
# TRUST_PROXY=1
# BUSINESS_TIME_ZONE=Europe/Minsk
# POSTGRES_USER=newerp
# POSTGRES_PASSWORD=<openssl rand -base64 32>
# POSTGRES_DB=flower_crm
# JWT_ACCESS_SECRET=<openssl rand -base64 48>
# API_PORT=3001
# JWT_ACCESS_TTL_SECONDS=900
# SESSION_TTL_SECONDS=1209600
# AUTH_COOKIE_NAME=erp_refresh
# AUTH_LOGIN_MAX_ATTEMPTS=20
# AUTH_LOGIN_WINDOW_SECONDS=60
# YANDEX_MAPS_API_KEY=<from developer.tech.yandex.ru Geosuggest>
# YANDEX_SUGGEST_LL=23.8313,53.6694
#
# Host bindings (docker-compose.prod.yml):
#   127.0.0.1:3000 -> web
#   127.0.0.1:3001 -> api
# Postgres: no host port. External surface: 22/80/443 only.
