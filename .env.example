# Application
NODE_ENV=development

# NestJS API
API_PORT=3001
WEB_URL=http://localhost:3000

# Next.js frontend (public, exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flower_crm
POSTGRES_PORT=5432

# Prisma / NestJS database connection
# Must match POSTGRES_* above for local Docker Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flower_crm?schema=public

# Auth (Phase 2)
# Use a long random secret in real environments. This value is a local placeholder only.
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-32chars
JWT_ACCESS_TTL_SECONDS=900
SESSION_TTL_SECONDS=1209600
AUTH_COOKIE_NAME=erp_refresh
# Login route throttle (used by LoginThrottleGuard on POST /auth/login)
AUTH_LOGIN_MAX_ATTEMPTS=20
AUTH_LOGIN_WINDOW_SECONDS=60

# Express trust proxy hop count. false/0 = disabled (default, direct/local access).
# Set to 1 when API sits behind one reverse proxy (nginx) that sets X-Forwarded-For.
# TRUST_PROXY=false

# Business calendar / order numbers / "today" in Orders UI (IANA time zone).
BUSINESS_TIME_ZONE=Europe/Minsk

# Seed (development only). Refuses to run when NODE_ENV=production.
# Set true to overwrite seeded users' password hashes with development defaults.
# SEED_RESET_PASSWORDS=true
