# erpbuket1 production environment EXAMPLE — copy to the VPS (outside Git):
#
#   sudo mkdir -p /etc/erpbuket1
#   sudo cp deploy/env/production.env.example /etc/erpbuket1/production.env
#   sudo chmod 600 /etc/erpbuket1/production.env
#   sudo nano /etc/erpbuket1/production.env
#
# Then (app only — does NOT touch host Nginx):
#   ./deploy/scripts/install.sh
#   ./deploy/scripts/deploy.sh
#   ./deploy/scripts/healthcheck.sh --mode=internal
#
# Public HTTPS (separate explicit confirmations; never auto-run by install/deploy):
#   CONFIRM_NGINX_INSTALL=YES ./deploy/scripts/install-nginx.sh --mode=http
#   CONFIRM_CERTBOT=YES CERTBOT_EMAIL=ops@example.com ./deploy/scripts/issue-cert.sh
#   CONFIRM_NGINX_INSTALL=YES ./deploy/scripts/install-nginx.sh --mode=https
#   ./deploy/scripts/healthcheck.sh --mode=public
#
# Backup / status / rollback:
#   ./deploy/scripts/backup.sh
#   ./deploy/scripts/status.sh
#   CONFIRM_ROLLBACK=YES ROLLBACK_TO=<sha> ./deploy/scripts/rollback.sh
#
# NEVER commit a real /etc/erpbuket1/production.env or paste live secrets into Git.

# -----------------------------------------------------------------------------
# Public identity (Nginx / Certbot / browser)
# -----------------------------------------------------------------------------
ERP_DOMAIN=erp.example.com

# Same-origin public URLs (must match the HTTPS site users open).
# Used for CORS / cookies (WEB_URL) and Next.js client API base (NEXT_PUBLIC_API_URL).
WEB_URL=https://erp.example.com
NEXT_PUBLIC_API_URL=https://erp.example.com

# Loopback host publish ports (must be free on the VPS; check vs shopbuket1).
ERP_WEB_PORT=3100
ERP_API_PORT=3101

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
TRUST_PROXY=1
BUSINESS_TIME_ZONE=Europe/Minsk

# Internal listen ports inside containers (do not change unless images change).
# Host mapping uses ERP_WEB_PORT / ERP_API_PORT above.
# API_PORT=3001
# web PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL (container only — no host port)
# -----------------------------------------------------------------------------
POSTGRES_USER=erpbuket1
POSTGRES_DB=flower_crm

# Prefer URL-safe password (A-Za-z0-9_-). Generate:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_PASSWORD

# Full Prisma/Nest connection string for api + migrate services.
# Host MUST be the compose service name "postgres" (not localhost).
# If POSTGRES_PASSWORD contains @ : / ? # & etc. — URL-encode it here.
# Example encoder: python3 -c "import urllib.parse; print(urllib.parse.quote('p@ss', safe=''))"
DATABASE_URL=postgresql://erpbuket1:CHANGE_ME_URL_SAFE_PASSWORD@postgres:5432/flower_crm?schema=public

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
#   openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ACCESS_TTL_SECONDS=900
SESSION_TTL_SECONDS=1209600
AUTH_COOKIE_NAME=erp_refresh
AUTH_LOGIN_MAX_ATTEMPTS=20
AUTH_LOGIN_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Optional — address suggestions (orders)
# -----------------------------------------------------------------------------
# YANDEX_MAPS_API_KEY=
# YANDEX_SUGGEST_LL=23.8313,53.6694
