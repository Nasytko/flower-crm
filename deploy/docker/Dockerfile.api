# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=22.23.2

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g pnpm@10.17.0
WORKDIR /app

# Copy manifests + sources first, then install — so workspace links are not wiped by later COPY.
FROM base AS build
ENV NODE_ENV=development
ENV DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flower_crm?schema=public
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY tsconfig.base.json turbo.json ./
COPY apps/api apps/api
COPY packages/shared packages/shared
COPY packages/database packages/database
RUN pnpm install --frozen-lockfile --ignore-scripts \
  && pnpm --filter @erp/database exec prisma generate \
  && pnpm exec tsc -p packages/shared/tsconfig.json \
  && pnpm exec tsc -p packages/database/tsconfig.json \
  && pnpm --filter @erp/api build

FROM build AS pruned
# deploy already pulls workspace packages; avoid cp onto identical hardlinks/symlinks.
RUN pnpm --filter @erp/api deploy --prod --legacy /app/deployed \
  && if [ ! -f /app/deployed/dist/main.js ]; then cp -a /app/apps/api/dist /app/deployed/dist; fi \
  && mkdir -p /app/deployed/dist \
  && cp -a /app/apps/api/dist/bootstrap-director.js /app/deployed/dist/bootstrap-director.js \
  && cp -a /app/apps/api/dist/reset-user-password.js /app/deployed/dist/reset-user-password.js \
  && test -f /app/deployed/dist/bootstrap-director.js \
  && test -f /app/deployed/dist/reset-user-password.js \
  && mkdir -p /app/deployed/node_modules/@erp/database/src \
  && rm -rf /app/deployed/node_modules/@erp/database/src/generated \
  && cp -a /app/packages/database/src/generated /app/deployed/node_modules/@erp/database/src/generated \
  && if [ ! -f /app/deployed/node_modules/@erp/database/dist/index.js ]; then \
       mkdir -p /app/deployed/node_modules/@erp/database/dist \
       && cp -a /app/packages/database/dist/. /app/deployed/node_modules/@erp/database/dist/; \
     fi \
  && if [ ! -f /app/deployed/node_modules/@erp/shared/dist/index.js ]; then \
       mkdir -p /app/deployed/node_modules/@erp/shared/dist \
       && cp -a /app/packages/shared/dist/. /app/deployed/node_modules/@erp/shared/dist/; \
     fi

FROM build AS migrate
ENV NODE_ENV=production
WORKDIR /app/packages/database
CMD ["pnpm", "exec", "prisma", "migrate", "deploy"]

FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nestjs

COPY --from=pruned --chown=nestjs:nodejs /app/deployed ./

USER nestjs
EXPOSE 3001
CMD ["node", "dist/main.js"]
