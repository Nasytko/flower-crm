generator client {
  provider     = "prisma-client"
  output       = "../src/generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  FLORIST
  MANAGER
  DIRECTOR
}

/// How the current employee session was established.
enum AuthStrength {
  PASSWORD
  PIN
}

/// Trusted device employee allowlist mode (explicit; never infer from empty list).
enum DeviceAccessMode {
  ALL_PIN_USERS
  SELECTED_USERS
}

enum WorkSessionCloseReason {
  MANUAL
  LOGOUT
  EXPIRED
  DEVICE_REVOKED
  FORCE
}

enum ProductType {
  FLOWER
  SERVICE
}

enum Unit {
  PIECE
}

/// Controlled vocabulary for flower product characteristics (no admin UI).
enum ProductAttrKind {
  FLOWER_KIND
  FLOWER_FORM
  VARIETY
  COLOR
  ORIGIN
}

enum StockMovementType {
  SUPPLY
  SUPPLY_REVERSAL
  SALE
  WRITE_OFF
  MANUAL_WRITE_OFF
  RETURN
  INVENTORY_ADJUSTMENT
  MANUAL_ADJUSTMENT
  /// Move unassembled stems into a physical assembled bouquet (onHand ↓, inBouquets ↑).
  ASSEMBLE
  /// Return fit stems from a bouquet back to unassembled stock.
  DISASSEMBLE_RETURN
  /// Write off damaged stems while disassembling / adjusting a bouquet.
  DISASSEMBLE_DAMAGE
  /// Final leave-shop of stems that were inside an assembled bouquet.
  ISSUE
  /// Direct leave-shop of unassembled product (no AssembledBouquet).
  DIRECT_ISSUE
}

enum SupplyStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum InventoryStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockLotSource {
  SUPPLY
  INVENTORY
}

model User {
  id                  String    @id @default(cuid())
  name                String
  login               String    @unique
  /// Optional; login allowed by email OR login nick.
  email               String?   @unique
  passwordHash        String
  role                Role
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  /// User-Agent string from the most recent successful login.
  lastLoginUserAgent  String?
  /// Fast PIN unlock (Argon2id hash only; plaintext never stored).
  pinEnabled          Boolean   @default(false)
  pinHash             String?
  pinUpdatedAt        DateTime?
  pinFailedAttempts   Int       @default(0)
  pinLockedUntil      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions                 Session[]
  auditLogs                AuditLog[]         @relation("AuditActor")
  stockMovements           StockMovement[]    @relation("StockMovementAuthor")
  suppliesCreated          Supply[]           @relation("SupplyCreator")
  suppliesPosted           Supply[]           @relation("SupplyPoster")
  suppliesCancelled        Supply[]           @relation("SupplyCanceller")
  suppliesMarkedPaid       Supply[]           @relation("SupplyPaidBy")
  inventoriesCreated       InventorySession[] @relation("InventoryCreator")
  inventoriesCompleted     InventorySession[] @relation("InventoryCompleter")
  inventoryItemsCounted    InventoryItem[]    @relation("InventoryItemCounter")
  ordersCreated            Order[]            @relation("OrderCreator")
  ordersUpdated            Order[]            @relation("OrderUpdater")
  trustedDevicesCreated    TrustedDevice[]    @relation("TrustedDeviceCreator")
  workSessionsOpened       WorkSession[]      @relation("WorkSessionOpener")
  deviceAllowlistEntries   TrustedDeviceUser[]
  assembledBouquets        AssembledBouquet[] @relation("AssembledBouquetAssembler")
  disassembledBouquets     AssembledBouquet[] @relation("AssembledBouquetDisassembler")
  issuedBouquets           AssembledBouquet[] @relation("AssembledBouquetIssuer")
  writtenOffBouquets       AssembledBouquet[] @relation("AssembledBouquetWriteOff")
  adjustedBouquets         AssembledBouquet[] @relation("AssembledBouquetAdjuster")
  posCartsOwned            PosCart[]          @relation("PosCartOwner")
  posCartPriceOverrides    PosCartLine[]      @relation("PosCartLinePriceOverride")
  paymentsCreated          Payment[]          @relation("PaymentCreator")
  paymentsConfirmed        Payment[]          @relation("PaymentConfirmer")
  cashShiftsOpened         CashShift[]        @relation("CashShiftOpener")
  cashShiftsClosed         CashShift[]        @relation("CashShiftCloser")
  cashMovementsCreated     CashMovement[]     @relation("CashMovementCreator")

  @@index([role, isActive])
  @@index([pinEnabled, isActive])
  @@map("users")
}

model Session {
  id                String       @id @default(cuid())
  userId            String
  tokenHash         String       @unique
  /// Previous refresh hash kept briefly for reuse/theft detection after rotation.
  previousTokenHash String?      @unique
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  /// Workstation lock: protected APIs reject until PIN/password unlock.
  lockedAt          DateTime?
  authStrength      AuthStrength @default(PASSWORD)
  /// After password step-up; required for critical admin ops.
  elevatedUntil     DateTime?
  workSessionId     String?
  /// Last *user* activity (explicit heartbeat); not polling.
  lastUserActivityAt DateTime?
  createdAt         DateTime     @default(now())
  lastUsedAt        DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workSession WorkSession? @relation(fields: [workSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([workSessionId])
  @@index([lockedAt])
  @@map("sessions")
}

/// Singleton org-wide security policy (non-secret fields only).
model SecurityPolicy {
  id                           Int      @id @default(1)
  pinEnabledOrg                Boolean  @default(true)
  deviceTrustDays              Int      @default(30)
  workSessionMaxHours          Int      @default(12)
  idleLockMinutes              Int      @default(5)
  pinMaxAttempts               Int      @default(5)
  pinLockoutMinutes            Int      @default(15)
  allowEmployeeSwitch          Boolean  @default(true)
  /// Always true in application logic; stored for audit/display.
  requirePasswordForWorkSession Boolean @default(true)
  updatedAt                    DateTime @updatedAt
  updatedByUserId              String?

  @@map("security_policies")
}

model TrustedDevice {
  id              String           @id @default(cuid())
  name            String
  tokenHash       String           @unique
  accessMode      DeviceAccessMode @default(ALL_PIN_USERS)
  createdByUserId String
  expiresAt       DateTime
  revokedAt       DateTime?
  lastSeenAt      DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy    User                @relation("TrustedDeviceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  allowedUsers TrustedDeviceUser[]
  workSessions WorkSession[]

  @@index([revokedAt, expiresAt])
  @@map("trusted_devices")
}

model TrustedDeviceUser {
  deviceId  String
  userId    String
  createdAt DateTime @default(now())

  device TrustedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([deviceId, userId])
  @@index([userId])
  @@map("trusted_device_users")
}

model WorkSession {
  id              String                  @id @default(cuid())
  deviceId        String
  openedByUserId  String
  openedAt        DateTime                @default(now())
  /// Absolute end; never extended by idle/activity.
  expiresAt       DateTime
  closedAt        DateTime?
  closeReason     WorkSessionCloseReason?
  lockedAt        DateTime?
  lastUserActivityAt DateTime?

  device   TrustedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  openedBy User          @relation("WorkSessionOpener", fields: [openedByUserId], references: [id], onDelete: Restrict)
  sessions Session[]

  @@index([deviceId, closedAt])
  @@index([expiresAt])
  @@map("work_sessions")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Shared attribute values for FLOWER nomenclature (created inline from product card).
model ProductAttributeValue {
  id             String          @id @default(cuid())
  kind           ProductAttrKind
  name           String
  /// Lowercased trimmed collapsed whitespace for uniqueness.
  normalizedName String
  /// Empty string when root-level; otherwise parent attribute id (e.g. kind for variety).
  parentKey      String          @default("")
  parentId       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  parent   ProductAttributeValue?  @relation("AttrHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductAttributeValue[] @relation("AttrHierarchy")

  productsAsKind    Product[] @relation("ProductFlowerKind")
  productsAsForm    Product[] @relation("ProductFlowerForm")
  productsAsVariety Product[] @relation("ProductVariety")
  productsAsColor   Product[] @relation("ProductColor")
  productsAsOrigin  Product[] @relation("ProductOrigin")

  @@unique([kind, parentKey, normalizedName])
  @@index([kind, parentKey])
  @@index([parentId])
  @@map("product_attribute_values")
}

model ProductImage {
  id        String   @id @default(cuid())
  /// Null while staged before product save; attached on create/update.
  productId String?
  mimeType  String
  byteSize  Int
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product        Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  primaryFor     Product? @relation("ProductPrimaryImage")

  @@index([productId, sortOrder])
  @@index([createdAt])
  @@map("product_images")
}

model Product {
  id            String      @id @default(cuid())
  name          String
  sku           String?     @unique
  type          ProductType
  description   String?
  unit          Unit
  /// Cost/reference for SERVICE only. Not authoritative for FLOWER purchase cost.
  purchasePrice Decimal?    @db.Decimal(12, 2)
  salePrice     Decimal?    @db.Decimal(12, 2)
  isActive      Boolean     @default(true)
  /// FLOWER-only optional characteristics (null for SERVICE / legacy rows).
  flowerKindId  String?
  flowerFormId  String?
  varietyId     String?
  colorId       String?
  originId      String?
  stemLengthCm  Int?
  primaryImageId String?    @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  flowerKind  ProductAttributeValue? @relation("ProductFlowerKind", fields: [flowerKindId], references: [id], onDelete: SetNull)
  flowerForm  ProductAttributeValue? @relation("ProductFlowerForm", fields: [flowerFormId], references: [id], onDelete: SetNull)
  variety     ProductAttributeValue? @relation("ProductVariety", fields: [varietyId], references: [id], onDelete: SetNull)
  color       ProductAttributeValue? @relation("ProductColor", fields: [colorId], references: [id], onDelete: SetNull)
  origin      ProductAttributeValue? @relation("ProductOrigin", fields: [originId], references: [id], onDelete: SetNull)
  primaryImage ProductImage?         @relation("ProductPrimaryImage", fields: [primaryImageId], references: [id], onDelete: SetNull)
  images       ProductImage[]

  stock          ProductStock?
  movements      StockMovement[]
  supplyItems    SupplyItem[]
  lots           StockLot[]
  inventoryItems InventoryItem[]
  bouquetItems   BouquetItem[]
  orderItemsAsProduct OrderItem[] @relation("OrderItemProduct")
  orderItemComponents OrderItemComponent[]
  stockReservations   StockReservation[]
  assembledComponents AssembledBouquetComponent[]
  posCartLinesAsProduct PosCartLine[] @relation("PosCartLineProduct")
  posCartLineComponents PosCartLineComponent[]

  @@index([type, isActive])
  @@index([name])
  @@index([isActive, name])
  @@index([flowerKindId])
  @@index([varietyId])
  @@index([colorId])
  @@map("products")
}

/// Current warehouse snapshot for FLOWER products only (1:1).
/// Single storage location today; do not merge multi-site stocks without an explicit transfer.
///
/// Formulas (no double-count):
///   available = quantityOnHand − quantityReserved
///   unassembledPhysical = quantityOnHand (= available + plannedReserve)
///   totalPhysical = quantityOnHand + quantityInBouquets
///
/// Aggregates are derived projections; movements + lots + AssembledBouquet* are the source of truth.
model ProductStock {
  productId          String   @id
  /// Unassembled stems physically on the shelf (available + planned reserve).
  quantityOnHand     Int      @default(0)
  /// Soft planned reserve for active unassembled order needs.
  quantityReserved   Int      @default(0)
  /// Stems currently inside ASSEMBLED physical bouquets (not auto-reallocatable).
  quantityInBouquets Int      @default(0)
  updatedAt          DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_stocks")
}

/// Append-only ledger of physical stock changes. quantity is a signed delta.
model StockMovement {
  id              String            @id @default(cuid())
  productId       String
  type            StockMovementType
  quantity        Int
  balanceAfter    Int
  sourceType      String?
  sourceId        String?
  comment         String?
  createdByUserId String?
  createdAt       DateTime          @default(now())

  product     Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy   User?                        @relation("StockMovementAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  allocations StockMovementLotAllocation[]

  @@index([productId, createdAt])
  @@index([type])
  @@index([createdAt])
  @@index([sourceType, sourceId])
  @@map("stock_movements")
}

/// Master data for supply vendors. Supply keeps a name snapshot for history.
model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  comment   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplies Supply[]

  @@index([isActive, name])
  @@map("suppliers")
}

model Supply {
  id                   String       @id @default(cuid())
  number               Int          @unique
  status               SupplyStatus @default(DRAFT)
  documentDate         DateTime     @db.Date
  /// Required FK to suppliers. Snapshot name kept for historical display.
  supplierId           String
  supplierName         String
  /// Last day to pay the invoice (business calendar date).
  paymentDueDate       DateTime?    @db.Date
  paidAt               DateTime?
  paidByUserId         String?
  comment              String?
  correctionOfSupplyId String?
  correctionReason     String?
  createdByUserId      String
  postedByUserId       String?
  cancelledByUserId    String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  postedAt             DateTime?
  cancelledAt          DateTime?

  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  correctionOf Supply?  @relation("SupplyCorrection", fields: [correctionOfSupplyId], references: [id], onDelete: Restrict)
  corrections  Supply[] @relation("SupplyCorrection")

  createdBy   User  @relation("SupplyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  postedBy    User? @relation("SupplyPoster", fields: [postedByUserId], references: [id], onDelete: SetNull)
  cancelledBy User? @relation("SupplyCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  paidBy      User? @relation("SupplyPaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)

  items SupplyItem[]

  @@index([status])
  @@index([documentDate])
  @@index([supplierId])
  @@index([paymentDueDate])
  @@index([paidAt])
  @@index([correctionOfSupplyId])
  @@index([createdAt])
  @@map("supplies")
}

model SupplyItem {
  id                String    @id @default(cuid())
  supplyId          String
  productId         String
  quantity          Int
  unitPurchasePrice Decimal   @db.Decimal(12, 2)
  /// Optional last usable calendar day; copied to StockLot on post. Null = unknown.
  usableUntil       DateTime? @db.Date
  createdAt         DateTime  @default(now())

  supply  Supply    @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot     StockLot?

  @@index([supplyId])
  @@index([productId])
  @@map("supply_items")
}

/// Physical receipt batch from supply or inventory surplus.
model StockLot {
  id                String         @id @default(cuid())
  productId         String
  sourceType        StockLotSource
  supplyItemId      String?        @unique
  inventoryItemId   String?        @unique
  receivedQuantity  Int
  remainingQuantity Int
  /// Null for inventory surplus (uncosted). Never fake 0.00.
  unitPurchasePrice Decimal?       @db.Decimal(12, 2)
  receivedAt        DateTime
  /// Last calendar day the lot may be promised / used (business TZ date). Null = no limit.
  usableUntil       DateTime?      @db.Date
  createdAt         DateTime       @default(now())
  reversedAt        DateTime?

  product       Product                       @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplyItem    SupplyItem?                   @relation(fields: [supplyItemId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem?                @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  allocations   StockMovementLotAllocation[]
  bouquetLots   AssembledBouquetComponentLot[]

  @@index([productId, receivedAt, createdAt])
  @@index([productId, usableUntil])
  @@index([sourceType])
  @@map("stock_lots")
}

/// Links outbound stock movements to consumed lots (FIFO traceability).
model StockMovementLotAllocation {
  id                String   @id @default(cuid())
  stockMovementId   String
  stockLotId        String
  quantity          Int
  /// Null when consuming an uncosted inventory surplus lot.
  unitPurchasePrice Decimal? @db.Decimal(12, 2)

  movement StockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  lot      StockLot      @relation(fields: [stockLotId], references: [id], onDelete: Restrict)

  @@index([stockMovementId])
  @@index([stockLotId])
  @@map("stock_movement_lot_allocations")
}

model InventorySession {
  id                String          @id @default(cuid())
  number            Int             @unique
  status            InventoryStatus @default(DRAFT)
  comment           String?
  createdByUserId   String
  completedByUserId String?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  createdBy   User            @relation("InventoryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  completedBy User?           @relation("InventoryCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)
  items       InventoryItem[]

  @@index([status])
  @@index([createdAt])
  @@map("inventory_sessions")
}

model InventoryItem {
  id                String    @id @default(cuid())
  inventorySessionId String
  productId         String
  expectedQuantity  Int
  countedQuantity   Int?
  countedByUserId   String?
  countedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  session   InventorySession @relation(fields: [inventorySessionId], references: [id], onDelete: Restrict)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  countedBy User?            @relation("InventoryItemCounter", fields: [countedByUserId], references: [id], onDelete: SetNull)
  lot       StockLot?

  @@unique([inventorySessionId, productId])
  @@index([inventorySessionId])
  @@index([productId])
  @@map("inventory_items")
}

/// Reusable bouquet recipe/template. NOT physical stock.
model Bouquet {
  id          String   @id @default(cuid())
  name        String
  description String?
  salePrice   Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  /// Optimistic concurrency token (not recipe history).
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items BouquetItem[]
  orderItems OrderItem[] @relation("OrderItemBouquet")
  assembledBouquets AssembledBouquet[] @relation("AssembledBouquetTemplate")
  posCartLines PosCartLine[] @relation("PosCartLineBouquetTemplate")

  @@index([isActive])
  @@index([name])
  @@index([isActive, name])
  @@map("bouquets")
}

model BouquetItem {
  id        String   @id @default(cuid())
  bouquetId String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bouquet Bouquet @relation(fields: [bouquetId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([bouquetId, productId])
  @@index([bouquetId])
  @@index([productId])
  @@map("bouquet_items")
}

enum OrderStatus {
  NEW
  /// At least one line is being assembled or partially ready.
  IN_PROGRESS
  /// All assembleable units are ASSEMBLED and ready to issue (may be partially issued).
  READY
  /// Fully issued (or remaining lines written off / cancelled without stock).
  COMPLETED
  CANCELLED
}

/// Lifecycle of a physical assembled product (WIP / display / issued).
enum AssembledBouquetStatus {
  ASSEMBLED
  DISASSEMBLED
  ISSUED
  WRITTEN_OFF
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum OrderItemType {
  PRODUCT
  BOUQUET
}

enum DiscountType {
  PERCENT
  FIXED
}

/// How the commercial document was created.
enum OrderSource {
  BACKOFFICE
  POS
}

/// Walk-in (cashier) vs scheduled pre-order.
enum OrderFulfillmentMode {
  WALK_IN
  SCHEDULED
}

/// Payment axis (orthogonal to assembly/issue). Computed from confirmed Payment rows.
enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CARD_TERMINAL
  ERIP
  ONLINE_CARD
  BANK_TRANSFER
  GIFT_CERTIFICATE
}

enum PaymentSource {
  POS
  BACKOFFICE
  WEBSITE
  EXTERNAL_INTEGRATION
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentKind {
  CHARGE
  REFUND
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SALE_IN
  REFUND_OUT
  FLOAT_IN
  FLOAT_OUT
  ADJUSTMENT
}

/// Working POS cart lifecycle (no warehouse impact until confirm).
enum PosCartStatus {
  OPEN
  PARKED
  CONFIRMED
  CANCELLED
}

/// Line kinds inside a POS cart. Bouquet instances are always quantity=1 per line.
enum PosCartLineType {
  PRODUCT
  SERVICE
  BOUQUET_TEMPLATE
  BOUQUET_CUSTOM
  ASSEMBLED
}

/// How a service (or child line) contributes to money.
enum PosPriceMode {
  /// Charged as its own amount (or added to bouquet unit price when inside composition).
  ADDITIONAL
  /// Visible in composition / assembly but not added again to totals.
  INCLUDED
}

/// Atomic per-day sequence for human-readable Order.number (DDMMYY-NNN).
model OrderDailyCounter {
  businessDate DateTime @id @db.Date
  lastNumber   Int
  updatedAt    DateTime @updatedAt

  @@map("order_daily_counters")
}

/// Atomic per-day sequence for AssembledBouquet.number (AB-DDMMYY-NNN).
model AssembledBouquetDailyCounter {
  businessDate DateTime @id @db.Date
  lastNumber   Int
  updatedAt    DateTime @updatedAt

  @@map("assembled_bouquet_daily_counters")
}

/// Commercial order document. Reservations + physical assembly / issue mutate warehouse.
model Order {
  id                       String               @id @default(cuid())
  /// Human-readable business number, e.g. 150926-001. Not a PK.
  number                   String               @unique
  /// Calendar day used for number allocation (business TZ).
  numberBusinessDate       DateTime             @db.Date
  status                   OrderStatus          @default(NEW)
  source                   OrderSource          @default(BACKOFFICE)
  fulfillmentMode          OrderFulfillmentMode @default(SCHEDULED)
  paymentStatus            OrderPaymentStatus   @default(UNPAID)
  /// Optional display name; phone is the primary customer identifier (empty allowed for WALK_IN).
  customerName             String               @default("")
  customerPhone            String               @default("")
  fulfillmentType          FulfillmentType
  fulfillmentDate          DateTime             @db.Date
  /// Local wall-clock HH:mm (business day). Not a UTC instant.
  fulfillmentTimeFrom      String?              @db.VarChar(5)
  fulfillmentTimeTo        String?              @db.VarChar(5)
  recipientName            String?
  recipientPhone           String?
  deliveryAddressText      String?
  deliveryLatitude         Decimal?             @db.Decimal(9, 6)
  deliveryLongitude        Decimal?             @db.Decimal(9, 6)
  deliveryProvider         String?
  deliveryProviderPlaceId  String?
  deliveryComment          String?
  orderComment             String?
  subtotal                 Decimal              @db.Decimal(12, 2)
  discountType             DiscountType?
  discountValue            Decimal?             @db.Decimal(12, 2)
  discountAmount           Decimal              @default(0) @db.Decimal(12, 2)
  total                    Decimal              @db.Decimal(12, 2)
  /// Snapshot of known COGS from issued / directly issued lines. Null if uncosted.
  actualCost               Decimal?             @db.Decimal(12, 2)
  /// True when any issue consumed at least one lot without unitPurchasePrice.
  hasUncostedConsumption   Boolean              @default(false)
  /// Idempotency for POS confirm (and future payment retries).
  idempotencyKey           String?              @unique
  version                  Int                  @default(1)
  createdByUserId          String
  updatedByUserId          String?
  inProgressAt             DateTime?
  readyAt                  DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  createdBy         User               @relation("OrderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy         User?              @relation("OrderUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  reservations      StockReservation[]
  assembledBouquets AssembledBouquet[]
  posCart           PosCart?           @relation("PosCartConfirmedOrder")
  payments          Payment[]

  @@index([fulfillmentDate, status])
  @@index([fulfillmentDate, fulfillmentType])
  @@index([fulfillmentDate, fulfillmentTimeFrom])
  @@index([status])
  @@index([source, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                    String        @id @default(cuid())
  orderId               String
  itemType              OrderItemType
  productId             String?
  /// Null for custom / vitrine-derived bouquet instances without a catalog template.
  bouquetId             String?
  /// Optional link: ADDITIONAL service line → parent bouquet/product line.
  parentOrderItemId     String?
  priceMode             PosPriceMode  @default(ADDITIONAL)
  nameSnapshot          String
  quantity              Int
  /// How many units of this line were issued directly (PRODUCT) or via AssembledBouquet ISSUE.
  quantityIssued        Int           @default(0)
  recommendedUnitPrice  Decimal?      @db.Decimal(12, 2)
  unitPrice             Decimal       @db.Decimal(12, 2)
  priceOverridden       Boolean       @default(false)
  lineDiscountType      DiscountType?
  lineDiscountValue     Decimal?      @db.Decimal(12, 2)
  lineDiscountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  lineSubtotal          Decimal       @db.Decimal(12, 2)
  sortOrder             Int           @default(0)
  createdAt             DateTime      @default(now())

  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?             @relation("OrderItemProduct", fields: [productId], references: [id], onDelete: Restrict)
  bouquet           Bouquet?             @relation("OrderItemBouquet", fields: [bouquetId], references: [id], onDelete: Restrict)
  parentOrderItem   OrderItem?           @relation("OrderItemParent", fields: [parentOrderItemId], references: [id], onDelete: Cascade)
  childOrderItems   OrderItem[]          @relation("OrderItemParent")
  components        OrderItemComponent[]
  assembledBouquets AssembledBouquet[]

  @@index([orderId])
  @@index([productId])
  @@index([bouquetId])
  @@index([parentOrderItemId])
  @@map("order_items")
}

/// Frozen bouquet (or future) composition requirement for Phase 8 reservations.
model OrderItemComponent {
  id                    String       @id @default(cuid())
  orderItemId           String
  productId             String
  productNameSnapshot   String
  productTypeSnapshot   ProductType
  unitSnapshot          Unit
  quantityPerItem       Int
  totalQuantity         Int
  /// For SERVICE lines inside a bouquet: INCLUDED vs ADDITIONAL (no double charge).
  priceMode             PosPriceMode @default(ADDITIONAL)
  unitSalePriceSnapshot Decimal?     @db.Decimal(12, 2)
  sortOrder             Int          @default(0)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([productId])
  @@map("order_item_components")
}

/// Mutable aggregate FLOWER reservation for an Order (not lot-bound).
/// Active while Order status is NEW / IN_PROGRESS / READY. Removed on COMPLETED/CANCELLED.
/// Planned reserve only covers still-unassembled requirements.
model StockReservation {
  id               String   @id @default(cuid())
  orderId          String
  productId        String
  requiredQuantity Int
  reservedQuantity Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@index([orderId])
  @@map("stock_reservations")
}

/// Physical assembled product (order bouquet, display bouquet, mono/mixed composition).
/// Distinct from Bouquet template and from commercial OrderItem.
model AssembledBouquet {
  id                  String                 @id @default(cuid())
  /// Human-readable number, e.g. AB-241021-001.
  number              String                 @unique
  status              AssembledBouquetStatus @default(ASSEMBLED)
  orderId             String?
  orderItemId         String?
  bouquetTemplateId   String?
  nameSnapshot        String
  /// Optimistic concurrency for assemble/adjust/disassemble/issue.
  version             Int                    @default(1)
  /// Client idempotency key to prevent duplicate assemble on retry.
  idempotencyKey      String?                @unique
  unitCost            Decimal?               @db.Decimal(12, 2)
  hasUncostedComponents Boolean              @default(false)
  assembledAt         DateTime               @default(now())
  assembledByUserId   String
  disassembledAt      DateTime?
  disassembledByUserId String?
  disassembleReason   String?
  issuedAt            DateTime?
  issuedByUserId      String?
  writtenOffAt        DateTime?
  writtenOffByUserId  String?
  writeOffReason      String?
  lastAdjustedAt      DateTime?
  lastAdjustedByUserId String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  order           Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem       OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  bouquetTemplate Bouquet? @relation("AssembledBouquetTemplate", fields: [bouquetTemplateId], references: [id], onDelete: SetNull)
  assembledBy     User     @relation("AssembledBouquetAssembler", fields: [assembledByUserId], references: [id], onDelete: Restrict)
  disassembledBy  User?    @relation("AssembledBouquetDisassembler", fields: [disassembledByUserId], references: [id], onDelete: SetNull)
  issuedBy        User?    @relation("AssembledBouquetIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  writtenOffBy    User?    @relation("AssembledBouquetWriteOff", fields: [writtenOffByUserId], references: [id], onDelete: SetNull)
  lastAdjustedBy  User?    @relation("AssembledBouquetAdjuster", fields: [lastAdjustedByUserId], references: [id], onDelete: SetNull)
  components      AssembledBouquetComponent[]
  posCartLines    PosCartLine[] @relation("PosCartLineAssembled")

  @@index([status])
  @@index([orderId])
  @@index([orderItemId])
  @@index([assembledAt])
  @@map("assembled_bouquets")
}

model AssembledBouquetComponent {
  id                 String   @id @default(cuid())
  assembledBouquetId String
  productId          String
  productNameSnapshot String
  quantity           Int
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  bouquet AssembledBouquet @relation(fields: [assembledBouquetId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  lots    AssembledBouquetComponentLot[]

  @@unique([assembledBouquetId, productId])
  @@index([assembledBouquetId])
  @@index([productId])
  @@map("assembled_bouquet_components")
}

/// Lot provenance pinned at assembly (cost + return path). remainingQuantity shrinks on issue/damage.
model AssembledBouquetComponentLot {
  id          String   @id @default(cuid())
  componentId String
  stockLotId  String
  quantity    Int
  /// Still physically inside the bouquet from this lot allocation.
  remainingQuantity Int
  unitPurchasePrice Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  component AssembledBouquetComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  stockLot  StockLot                  @relation(fields: [stockLotId], references: [id], onDelete: Restrict)

  @@index([componentId])
  @@index([stockLotId])
  @@map("assembled_bouquet_component_lots")
}

/// POS working cart. Does NOT reserve stock or create warehouse movements until confirm.
model PosCart {
  id                   String        @id @default(cuid())
  status               PosCartStatus @default(OPEN)
  ownerUserId          String
  /// Optimistic concurrency for multi-device edits.
  version              Int           @default(1)
  discountType         DiscountType?
  discountValue        Decimal?      @db.Decimal(12, 2)
  discountAmount       Decimal       @default(0) @db.Decimal(12, 2)
  subtotal             Decimal       @default(0) @db.Decimal(12, 2)
  total                Decimal       @default(0) @db.Decimal(12, 2)
  parkedAt             DateTime?
  parkedLabel          String?
  /// Set on successful confirm; unique for idempotent retries.
  confirmIdempotencyKey String?      @unique
  confirmedOrderId     String?       @unique
  confirmedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  owner          User          @relation("PosCartOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  confirmedOrder Order?        @relation("PosCartConfirmedOrder", fields: [confirmedOrderId], references: [id], onDelete: SetNull)
  lines          PosCartLine[]

  @@index([ownerUserId, status])
  @@index([status, updatedAt])
  @@map("pos_carts")
}

model PosCartLine {
  id                     String         @id @default(cuid())
  cartId                 String
  lineType               PosCartLineType
  productId              String?
  bouquetTemplateId      String?
  assembledBouquetId     String?
  /// ADDITIONAL service attached to a specific bouquet/product instance in the cart.
  parentLineId           String?
  priceMode              PosPriceMode   @default(ADDITIONAL)
  nameSnapshot           String
  /// Bouquet / assembled instances are always 1; products/services may be >1.
  quantity               Int            @default(1)
  recommendedUnitPrice   Decimal        @db.Decimal(12, 2)
  unitPrice              Decimal        @db.Decimal(12, 2)
  priceOverridden        Boolean        @default(false)
  priceOverrideReason    String?
  priceOverriddenByUserId String?
  lineDiscountType       DiscountType?
  lineDiscountValue      Decimal?       @db.Decimal(12, 2)
  lineDiscountAmount     Decimal        @default(0) @db.Decimal(12, 2)
  lineSubtotal           Decimal        @db.Decimal(12, 2)
  sortOrder              Int            @default(0)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  cart                  PosCart                @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product               Product?               @relation("PosCartLineProduct", fields: [productId], references: [id], onDelete: Restrict)
  bouquetTemplate       Bouquet?               @relation("PosCartLineBouquetTemplate", fields: [bouquetTemplateId], references: [id], onDelete: Restrict)
  assembledBouquet      AssembledBouquet?      @relation("PosCartLineAssembled", fields: [assembledBouquetId], references: [id], onDelete: Restrict)
  parentLine            PosCartLine?           @relation("PosCartLineParent", fields: [parentLineId], references: [id], onDelete: Cascade)
  childLines            PosCartLine[]          @relation("PosCartLineParent")
  priceOverriddenBy     User?                  @relation("PosCartLinePriceOverride", fields: [priceOverriddenByUserId], references: [id], onDelete: SetNull)
  components            PosCartLineComponent[]

  @@index([cartId, sortOrder])
  @@index([assembledBouquetId])
  @@index([parentLineId])
  @@map("pos_cart_lines")
}

model PosCartLineComponent {
  id                    String       @id @default(cuid())
  lineId                String
  productId             String
  productNameSnapshot   String
  productTypeSnapshot   ProductType
  unitSnapshot          Unit         @default(PIECE)
  quantity              Int
  unitSalePriceSnapshot Decimal?     @db.Decimal(12, 2)
  /// SERVICE: INCLUDED in bouquet price vs ADDITIONAL charge inside the instance.
  priceMode             PosPriceMode @default(ADDITIONAL)
  sortOrder             Int          @default(0)
  createdAt             DateTime     @default(now())

  line    PosCartLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([lineId])
  @@index([productId])
  @@map("pos_cart_line_components")
}

/// Physical / logical cash drawer (minimal: one MAIN register seeded by migration).
model CashRegister {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts CashShift[]

  @@map("cash_registers")
}

/// Internal ERP cash shift (not a fiscal device shift).
model CashShift {
  id              String          @id @default(cuid())
  cashRegisterId  String
  status          CashShiftStatus @default(OPEN)
  openedByUserId  String
  closedByUserId  String?
  openingFloat    Decimal         @db.Decimal(12, 2)
  expectedCash    Decimal?        @db.Decimal(12, 2)
  countedCash     Decimal?        @db.Decimal(12, 2)
  discrepancy     Decimal?        @db.Decimal(12, 2)
  openedAt        DateTime        @default(now())
  closedAt        DateTime?
  note            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  cashRegister CashRegister   @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  openedBy     User           @relation("CashShiftOpener", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy     User?          @relation("CashShiftCloser", fields: [closedByUserId], references: [id], onDelete: SetNull)
  movements    CashMovement[]
  payments     Payment[]

  @@index([cashRegisterId, status])
  @@index([status, openedAt])
  @@map("cash_shifts")
}

model CashMovement {
  id              String           @id @default(cuid())
  cashShiftId     String
  type            CashMovementType
  amount          Decimal          @db.Decimal(12, 2)
  paymentId       String?
  note            String?
  createdByUserId String
  createdAt       DateTime         @default(now())

  cashShift CashShift @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  payment   Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy User      @relation("CashMovementCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([cashShiftId, createdAt])
  @@index([paymentId])
  @@map("cash_movements")
}

/// Charge or refund against an Order. Confirmed amounts drive Order.paymentStatus.
model Payment {
  id                     String         @id @default(cuid())
  orderId                String
  kind                   PaymentKind    @default(CHARGE)
  amount                 Decimal        @db.Decimal(12, 2)
  currency               String         @default("BYN") @db.VarChar(3)
  method                 PaymentMethod
  source                 PaymentSource
  status                 PaymentStatus  @default(PENDING)
  /// REFUND → original CHARGE payment.
  parentPaymentId        String?
  externalTransactionId  String?
  externalProvider       String?
  idempotencyKey         String         @unique
  cashShiftId            String?
  /// True when staff manually recorded ERIP/terminal/online (not provider webhook).
  isManual               Boolean        @default(false)
  note                   String?
  /// Non-sensitive provider payload / UI hints (never card PAN/CVV).
  metadata               Json?
  createdByUserId        String
  confirmedByUserId      String?
  createdAt              DateTime       @default(now())
  confirmedAt            DateTime?
  updatedAt              DateTime       @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  parentPayment Payment?       @relation("PaymentRefundParent", fields: [parentPaymentId], references: [id], onDelete: Restrict)
  refunds       Payment[]      @relation("PaymentRefundParent")
  cashShift     CashShift?     @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("PaymentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedBy   User?          @relation("PaymentConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  cashMovements CashMovement[]

  @@unique([externalProvider, externalTransactionId])
  @@index([orderId, status])
  @@index([cashShiftId])
  @@index([parentPaymentId])
  @@index([createdAt])
  @@map("payments")
}
